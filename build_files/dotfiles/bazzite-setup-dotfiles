#!/usr/bin/env bash
set -euo pipefail

config_dir="$HOME/.config"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/bazzite-dotfiles"
bundle_dir=/usr/share/bazzite-dotfiles

# Serialize service startup and manual invocation for this user.
mkdir -p "$state_dir"
exec 9>"$state_dir/setup.lock"
flock 9

if [[ -f "$state_dir/subrepos-v1" && -e "$config_dir/.git" &&
      -e "$config_dir/nvim/.git" && -e "$config_dir/tmux/.git" ]]; then
    exit 0
fi

work_dir=$(mktemp -d "$HOME/.bazzite-dotfiles.XXXXXX")
trap 'rm -rf -- "$work_dir"' EXIT

merge_repository() {
    local name="$1" destination="$2" origin="$3" revision="${4:-}"
    local source="$work_dir/$name"

    # Also handles a parent already initialized by the first version of setup.
    if [[ -e "$destination/.git" || -L "$destination/.git" ]]; then
        git -C "$destination" remote set-url origin "$origin"
        return
    fi

    git clone --quiet -- "$bundle_dir/$name.bundle" "$source"
    git -C "$source" remote set-url origin "$origin"
    if [[ -n "$revision" ]]; then
        # Only the temporary clone is reset. Existing user repos keep their work.
        git -C "$source" reset --hard "$revision"
    fi

    mkdir -p "$destination"
    # Merge directories and retain destination-only files, including hidden files.
    rsync -rlpt --ignore-times --force --omit-dir-times \
        --exclude='/.git/' "$source/" "$destination/"
    mv -- "$source/.git" "$destination/.git"
}

merge_repository dotfiles "$config_dir" git@mkoseler:MKoseler/dotfiles.git

for name in nvim tmux; do
    read -r mode type revision path < <(git -C "$config_dir" ls-tree HEAD -- "$name")
    if [[ "$mode" != 160000 ]]; then
        echo "Expected $name to be a Git submodule in $config_dir" >&2
        exit 1
    fi
    merge_repository "$name" "$config_dir/$name" \
        "git@mkoseler:MKoseler/${name}conf.git" "$revision"
done

# Register existing nested clones without changing the tracked .gitmodules file.
git -C "$config_dir" submodule init -- nvim tmux
git -C "$config_dir" submodule foreach --quiet '
    git -C "$toplevel" config "submodule.$name.url" "$(git remote get-url origin)"
'

touch "$state_dir/subrepos-v1"
echo "==> Dotfiles, Neovim, and tmux repositories ready in $config_dir"
